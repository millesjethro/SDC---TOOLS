{
  "manifest_version": 3,
  "name": "SDC - SCRAPER",
  "version": "1.0.1",
  "description": "Scrape tables and lists from the current webpage and export to Excel or your clipboard.",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"]
}
