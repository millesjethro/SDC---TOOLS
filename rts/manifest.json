{
  "manifest_version": 3,
  "name": "SDC - RTS",
  "version": "1.7.0",
  "description": "SDC - RTS \u2013 outlines report issues (missing URLs, metadata, bad file names, double spaces) on Social Media Report Builder.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://next.socialmediareportbuilder.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://next.socialmediareportbuilder.com/*"
      ],
      "js": [
        "modes/bulk_no_rh.js",
        "modes/bulk_rh.js",
        "modes/standard.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SDC - RTS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}